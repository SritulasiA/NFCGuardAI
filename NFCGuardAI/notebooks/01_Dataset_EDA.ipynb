      "source": [
        "# Dataset inspection and exploratory visualization",
        "\n\nSet Jupyter working directory to `notebooks/`. Real NFC dataset must be prepared separately.
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "from pathlib import Path\n",
        "from nfcguard.dataset.readers import source_report\n",
        "from nfcguard.dataset.store import SignalStore\n",
        "from nfcguard.visualization.plots import eda_figures\n"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "# First run: nfcguard prepare --source data/NFC_Relay.zip\n",
        "store = SignalStore(\"../data/processed\")\n",
        "print(store.manifest)\n",
        "print(store.meta.groupby(\"subtype\").size())\n"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "eda_figures(store,\"../outputs/notebooks/eda\",dpi=600)\n",
        "print(\"Figures saved under outputs/notebooks/eda\")"
      ]
    }
  ],
